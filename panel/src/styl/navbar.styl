html, body
  margin 0
  padding 0
  width 100%
  height 100%
  background #f5f5f7
  user-select none
  -webkit-user-select none
  overflow hidden
  font-family -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif
  -webkit-font-smoothing antialiased

.navbar
  box-sizing border-box
  width 100%
  height 100%
  min-height 100%
  background #f5f5f7
  border-bottom 1px solid rgba(0, 0, 0, 0.09)
  display flex
  align-items center
  padding 0 10px
  gap 8px

.navbar.macos
  padding-left 78px

.nav-group
  display flex
  align-items center
  gap 2px
  flex-shrink 0

.btn
  width 28px
  height 28px
  display flex
  align-items center
  justify-content center
  border none
  border-radius 6px
  background transparent
  color #4c4d52
  cursor pointer
  padding 0
  box-sizing border-box
  transition background-color 0.15s ease, color 0.15s ease, opacity 0.15s ease, transform 0.1s ease

.btn:hover:not(:disabled)
  background rgba(0, 0, 0, 0.06)
  color #1a1a1c

.btn:active:not(:disabled)
  background rgba(0, 0, 0, 0.12)
  transform scale(0.95)

.btn:disabled
  opacity 0.24
  cursor default
  pointer-events none

.btn svg
  width 16px
  height 16px
  stroke currentColor
  fill none
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
  display block
  flex-shrink 0

.url-container
  flex 1 1 0%
  min-width 0
  width 100%
  height calc(100% - 16px)
  min-height 28px
  max-height 34px
  display flex
  align-items center
  background #ffffff
  border 1px solid rgba(0, 0, 0, 0.12)
  border-radius 8px
  padding 0 10px
  gap 8px
  box-sizing border-box
  box-shadow 0 1px 2px rgba(0, 0, 0, 0.03)
  transition border-color 0.18s ease, box-shadow 0.18s ease

.url-container:hover:not(:focus-within)
  border-color rgba(0, 0, 0, 0.2)

.url-container:focus-within
  border-color #007aff
  box-shadow 0 0 0 3px rgba(0, 122, 255, 0.18), 0 1px 2px rgba(0, 0, 0, 0.04)

.url-container:focus-within .url-icon
  color #007aff

.url-icon
  display flex
  align-items center
  justify-content center
  color #8e8e93
  flex-shrink 0
  width 14px
  height 14px
  transition color 0.18s ease

.url-icon svg
  width 14px
  height 14px
  stroke currentColor
  fill none
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
  display block
  flex-shrink 0

.url-container input
  flex 1 1 0%
  min-width 0
  width 100%
  height 100%
  border none
  outline none
  background transparent
  padding 0
  margin 0
  font-size 13px
  color #1d1d1f
  letter-spacing -0.01em
  box-sizing border-box

.url-container input::placeholder
  color #9a9aa0
  font-weight 400

.window-actions
  display flex
  align-items center
  gap 1px
  flex-shrink 0

.window-actions .btn.close:hover:not(:disabled)
  background #e81123
  color #ffffff
